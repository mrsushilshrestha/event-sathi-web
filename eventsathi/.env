# EventSathi Environment Configurations

# Django Settings
SECRET_KEY=django-insecure-eventsathi-dev-secret-key-change-in-production
DEBUG=True

# ==============================================================================
# SMTP Email configuration for sending actual verification codes/OTPs via email
# ==============================================================================
# If EMAIL_HOST_USER is left empty, the system automatically falls back to the
# Console backend (printing emails to the terminal running the dev server).

# Standard Providers Setup Guidance:
# ------------------------------------------------------------------------------
# 1. GMAIL (Google Workspace / Personal Account)
#    EMAIL_HOST=smtp.gmail.com
#    EMAIL_PORT=587
#    EMAIL_USE_TLS=True
#    EMAIL_HOST_USER=your-email@gmail.com
#    EMAIL_HOST_PASSWORD=your-16-character-app-password
#    (Note: You MUST generate an App Password from your Google Account settings,
#     standard account passwords will NOT work with 2FA enabled!)
#
# 2. OUTLOOK / OFFICE 365
#    EMAIL_HOST=smtp.office365.com
#    EMAIL_PORT=587
#    EMAIL_USE_TLS=True
#    EMAIL_HOST_USER=your-email@outlook.com
#    EMAIL_HOST_PASSWORD=your-app-password-or-account-password
#
# 3. MAILTRAP (For safe Sandbox development testing)
#    EMAIL_HOST=sandbox.smtp.mailtrap.io
#    EMAIL_PORT=2525
#    EMAIL_USE_TLS=True
#    EMAIL_HOST_USER=your-mailtrap-username
#    EMAIL_HOST_PASSWORD=your-mailtrap-password
# ------------------------------------------------------------------------------

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=3bpowershub@gmail.com
EMAIL_HOST_PASSWORD=vmqnyyweegbbflvd
DEFAULT_FROM_EMAIL=3bpowershub@gmail.com
